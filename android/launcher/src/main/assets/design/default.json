{
  "name": "Sphere",
  "theme": {
    "background": "wallpaper", "scrim": "#66000000",
    "accent": "#7CC4FF", "text": "#FFFFFF", "textDim": "#B3FFFFFF", "surface": "#33FFFFFF",
    "fonts": { "clock": "default", "display": "default", "body": "default" },
    "cornerRadius": 20, "blur": true, "iconShape": "system", "lightStatusIcons": true
  },
  "layout": [
    { "type": "clock", "size": 64, "align": "start", "date": true },
